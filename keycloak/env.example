# Template – copy to .env and replace EVERY "change-me" value:
#   cp env.example .env
# Generate passwords e.g. with:  openssl rand -base64 24
# .env is listed in .gitignore and must never be committed.

# --- CIB seven image -----------------------------------------------------------
# Enterprise edition from the CIB seven enterprise registry. Log in first:
#   docker login enterprise.artifacts.cibseven.org
CIBSEVEN_IMAGE=enterprise.artifacts.cibseven.org/cibseven:run-3.0.0-ee
# Base image of the WildFly variant (docker-compose.wildfly.yml, built from ../wildfly)
CIBSEVEN_WILDFLY_IMAGE=enterprise.artifacts.cibseven.org/cibseven:wildfly-3.0.0-ee

# --- AI agent connector (LLM) --------------------------------------------------
# API key of the LLM provider. Only stored here, passed to CIB seven as OPENAI_API_KEY.
OPENAI_API_KEY=change-me
# OpenAI-compatible endpoint, e.g. https://api.openai.com/v1, https://openrouter.ai/api/v1,
# http://host.containers.internal:11434/v1 (Ollama on the host)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used when a BPMN AI agent task leaves "Model" empty
AI_DEFAULT_MODEL=gpt-6-luna

# --- Public URLs / ports (as the browser sees them) ---------------------------
CIBSEVEN_PORT=8080
CIBSEVEN_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PORT=8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# --- Databases ----------------------------------------------------------------
CIBSEVEN_DB_USER=cibseven
CIBSEVEN_DB_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak admin (master realm, http://localhost:8180/admin) ---------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- OIDC client "cibseven-webclient" -----------------------------------------
# Set in Keycloak during the realm import AND used by CIB seven.
CIBSEVEN_OIDC_CLIENT_SECRET=change-me

# --- Service account client "cibseven-identity" (cibseven-keycloak plugin) --------
# Set in Keycloak during the realm import AND used by the plugin to read users/groups.
CIBSEVEN_IDENTITY_CLIENT_SECRET=change-me
# Plugin version, must match the jar in ./plugin (see plugin/fetch-plugin.sh)
KEYCLOAK_PLUGIN_VERSION=2.2.1

# --- Admin user in realm "cibseven" -----------------------------------------
# cibadmin -> group camunda-admin (full permissions); the only user of this setup
KC_USER_CIBADMIN_PASSWORD=change-me-please
