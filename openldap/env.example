# Template – copy to .env and replace EVERY "change-me" value:
#   cp env.example .env
# Generate passwords e.g. with:  openssl rand -base64 24
# .env is listed in .gitignore and must never be committed.

# --- CIB seven image ----------------------------------------------------------
# Enterprise edition from the CIB seven enterprise registry. Log in first:
#   docker login enterprise.artifacts.cibseven.org
CIBSEVEN_IMAGE=enterprise.artifacts.cibseven.org/cibseven:run-3.0.0-ee
# Base image of the WildFly variant (docker-compose.wildfly.yml, built from ../wildfly)
CIBSEVEN_WILDFLY_IMAGE=enterprise.artifacts.cibseven.org/cibseven:wildfly-3.0.0-ee

# --- Webclient bpm provider (see README) --------------------------------------
# REST:   org.cibseven.webapp.providers.SevenProviderEE   (default)
# Direct: org.cibseven.webapp.providers.SevenDirectProviderEE
CIBSEVEN_BPM_PROVIDER=org.cibseven.webapp.providers.SevenProviderEE

# --- Engine password policy (see README, decision E15) ------------------------
# Applies to users managed by CIB seven itself (internal setup). OFF for quick testing;
# true = at least 10 characters, upper and lower case, a digit and a special character,
# not containing the user id.
CIBSEVEN_PASSWORD_POLICY=false

# --- AI agent connector (LLM) -------------------------------------------------
# API key of the LLM provider. Only stored here, passed to CIB seven as OPENAI_API_KEY.
OPENAI_API_KEY=change-me
# OpenAI-compatible endpoint, e.g. https://api.openai.com/v1, https://openrouter.ai/api/v1,
# http://host.containers.internal:11434/v1 (Ollama on the host)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used when a BPMN AI agent task leaves "Model" empty
AI_DEFAULT_MODEL=gpt-6-luna

# --- Ports --------------------------------------------------------------------
CIBSEVEN_PORT=8080
LDAP_PORT=1389

# --- Database -----------------------------------------------------------------
CIBSEVEN_DB_USER=cibseven
CIBSEVEN_DB_PASSWORD=change-me

# --- OpenLDAP -----------------------------------------------------------------
# cn=admin,dc=cibseven,dc=local  (write access, only for ldap-seed / maintenance)
LDAP_ADMIN_PASSWORD=change-me
# cn=admin,cn=config (OpenLDAP configuration)
LDAP_CONFIG_PASSWORD=change-me
# cn=readonly,dc=cibseven,dc=local  (bind user of CIB seven)
LDAP_READONLY_PASSWORD=change-me

# --- Admin user (group camunda-admin, all permissions) ------------------------
# Created in LDAP by the one-off job ldap-seed; the only user of this setup.
CIBSEVEN_ADMIN_USER=cibadmin
CIBSEVEN_ADMIN_PASSWORD=change-me
