# Template for ldap-seed (seed.sh). @...@ placeholders are replaced at runtime;
# passwords end up only as SSHA hashes in the directory – never in plain text in the repo.

dn: ou=people,@BASE_DN@
objectClass: organizationalUnit
ou: people

dn: ou=groups,@BASE_DN@
objectClass: organizationalUnit
ou: groups

dn: uid=@ADMIN_ID@,ou=people,@BASE_DN@
objectClass: inetOrgPerson
uid: @ADMIN_ID@
cn: CIB Admin
givenName: CIB
sn: Admin
mail: @ADMIN_ID@@example.org
userPassword: @ADMIN_PASSWORD_HASH@

dn: cn=camunda-admin,ou=groups,@BASE_DN@
objectClass: groupOfNames
cn: camunda-admin
description: CIB seven administrators (full permissions via admin-auth)
member: uid=@ADMIN_ID@,ou=people,@BASE_DN@
