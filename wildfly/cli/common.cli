# Engine configuration shared by both WildFly variants (applied at image build time).
# Equivalent of the relevant production.yml settings of CIB seven Run plus admin-auth.
embed-server --server-config=standalone.xml
batch

# production.yml equivalents (authorizationEnabled is already true in the distribution)
# Password policy for users managed by the engine: OFF by default for quick testing,
# switched on at runtime with CIBSEVEN_PASSWORD_POLICY=true (README, decision E15).
/subsystem=camunda-bpm-platform/process-engines=default:map-put(name=properties,key=enablePasswordPolicy,value="${env.CIBSEVEN_PASSWORD_POLICY:false}")
/subsystem=camunda-bpm-platform/process-engines=default:map-put(name=properties,key=deserializationTypeValidationEnabled,value=true)

# admin-auth equivalent: all permissions for group camunda-admin.
/subsystem=camunda-bpm-platform/process-engines=default:list-add(name=plugins,value={"class"=>"org.cibseven.bpm.engine.impl.plugin.AdministratorAuthorizationPlugin","properties"=>{"administratorGroupName"=>"camunda-admin"}})

run-batch
stop-embedded-server
